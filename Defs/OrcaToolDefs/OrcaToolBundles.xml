      <li>get_colony_summary</li>
    </toolNames>
    <priority>20</priority>
    <includeByDefault>true</includeByDefault>
    <exposeToRoles><li>tool</li></exposeToRoles>
  </DeepseekTheOrca.OrcaToolBundleDef>

