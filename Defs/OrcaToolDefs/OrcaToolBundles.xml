    <defName>DTO_ToolBundle_ColonyState</defName>
    <toolBundleId>colony_state</toolBundleId>
    <label>Colony state</label>
    <description>Use for current colony condition, pressure, storyteller context, food, medicine, wealth, threat, recent incidents, and broad situation checks.</description>
    <aliases>
      <li>殖民地</li>
      <li>状况</li>
      <li>压力</li>
      <li>食物</li>
      <li>药品</li>
      <li>威胁</li>
      <li>colony</li>
      <li>status</li>
      <li>pressure</li>
    </aliases>
